# Generated formal outputs:

formal/*/model/
formal/*/work/
formal/*/engine_*/
formal/*/config/

# SymbiYosys / Yosys generated reports and state
formal/*/status
formal/*/status.sqlite
formal/*/*.xml
formal/*/PASS
formal/*/logfile.txt


